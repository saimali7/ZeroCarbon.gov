# ZeroCarbon.gov configuration
#
# `npm start` copies this file to `.env` on first run. Every value has a safe
# default, so the app works with this file unchanged and no API keys.

# Preferred ports. If one is busy, the launcher picks the next free port.
WEB_PORT=3000
API_PORT=4000

# AI mode: auto | demo | live
#   auto  live when OPENROUTER_API_KEY is set, otherwise demo
#   demo  offline: bundled AI outputs and templates (no key, no internet)
#   live  always call OpenRouter (requires OPENROUTER_API_KEY)
AI_MODE=auto

# OpenRouter (optional). Get a key at https://openrouter.ai/keys
# Never commit a real key: put it only in your local .env.
OPENROUTER_API_KEY=
# Any OpenRouter model id that supports structured outputs.
OPENROUTER_MODEL=google/gemini-3.8-flash
# Optional comma-separated fallbacks, tried in order if the main model fails.
OPENROUTER_FALLBACK_MODELS=
